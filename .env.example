# AECS Environment Variables
# Copy this file to .env and fill in your keys
# NEVER commit this file to git

# Optional authenticated-evidence locations. Keep both outside target repositories.
# AECS_EVIDENCE_STORE=json
# AECS_EVIDENCE_PATH=C:\aecs-data\evidence
# AECS_EVIDENCE_KEY_DIRECTORY=C:\aecs-secrets\evidence-keys

# PostgreSQL evidence backend. Keep real values only in .env or a secret manager.
# AECS_POSTGRES_PASSWORD=replace-with-a-local-secret
# AECS_POSTGRES_CONNECTION_STRING=Host=localhost;Port=5432;Database=aecs;Username=aecs;Password=replace-with-a-local-secret

# ============================================
# FREE OPTIONS (recommended for development)
# ============================================

# Groq — Free tier, very fast inference
# Sign up: https://console.groq.com
OPENAI_API_KEY=gsk-your-groq-key-here
OPENAI_MODEL=llama-3.1-8b-instant
OPENAI_BASE_URL=https://api.groq.com/openai/v1

# Google Gemini — Free tier (15 RPM, 1M tokens/day)
# Sign up: https://aistudio.google.com/apikey
# OPENAI_API_KEY=your-gemini-key-here
# OPENAI_MODEL=gemini-1.5-flash
# OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai

# Together AI — Free $25 credits on signup
# Sign up: https://api.together.xyz
# OPENAI_API_KEY=your-together-key-here
# OPENAI_MODEL=meta-llama/Meta-Llama-3.1-70B-Instruct-Turbo
# OPENAI_BASE_URL=https://api.together.xyz/v1

# Cerebras — Free tier, very fast
# Sign up: https://cloud.cerebras.ai
# OPENAI_API_KEY=your-cerebras-key-here
# OPENAI_MODEL=llama3.3-70b
# OPENAI_BASE_URL=https://api.cerebras.ai/v1

# SambaNova — Free tier
# Sign up: https://cloud.sambanova.ai
# OPENAI_API_KEY=your-sambanova-key-here
# OPENAI_MODEL=Meta-Llama-3.1-70B-Instruct
# OPENAI_BASE_URL=https://api.sambanova.ai/v1

# ============================================
# PAID OPTIONS
# ============================================

# OpenAI
# OPENAI_API_KEY=sk-your-openai-key-here
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1

# Anthropic aliases
# NOTE: CloudAdapter currently expects an OpenAI-compatible /chat/completions
# endpoint. The native Anthropic API is not supported without a compatible proxy.
# ANTHROPIC_API_KEY=sk-ant-your-key-here
# ANTHROPIC_MODEL=claude-3-5-sonnet
# ANTHROPIC_BASE_URL=https://your-openai-compatible-proxy.example/v1
