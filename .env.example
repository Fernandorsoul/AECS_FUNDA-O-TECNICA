# AECS Environment Variables
# Copy this file to .env and fill in your keys
# NEVER commit this file to git

OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

